local function BuildMK1Armor(character)
    local folder = Instance.new("Folder")
    folder.Name = "MK1_Armor_Model"
    folder.Parent = character

    local head = character:FindFirstChild("Head")
    local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    local leftArm = character:FindFirstChild("Left Arm") or character:FindFirstChild("LeftUpperArm")
    local rightArm = character:FindFirstChild("Right Arm") or character:FindFirstChild("RightUpperArm")
    local leftLeg = character:FindFirstChild("Left Leg") or character:FindFirstChild("LeftUpperLeg")
    local rightLeg = character:FindFirstChild("Right Leg") or character:FindFirstChild("RightUpperLeg")
    local humanoid = character:FindFirstChildOfClass("Humanoid")

    -- Atributos de Velocidade e Tamanho Compacto (~1.2x)
    if humanoid then
        humanoid.WalkSpeed = 26
        humanoid.JumpPower = 70
        
        -- Natação Rápida
        pcall(function()
            humanoid.SwimmingSpeed = 65
        end)
        
        local hs = humanoid:FindFirstChild("BodyHeightScale") or Instance.new("NumberValue", humanoid)
        hs.Name = "BodyHeightScale"
        hs.Value = 1.2

        local ws = humanoid:FindFirstChild("BodyWidthScale") or Instance.new("NumberValue", humanoid)
        ws.Name = "BodyWidthScale"
        ws.Value = 1.1

        local ds = humanoid:FindFirstChild("BodyDepthScale") or Instance.new("NumberValue", humanoid)
        ds.Name = "BodyDepthScale"
        ds.Value = 1.1

        local headScale = humanoid:FindFirstChild("HeadScale") or Instance.new("NumberValue", humanoid)
        headScale.Name = "HeadScale"
        headScale.Value = 1.1
    end

    -- Pele Verde Escuro
    _G.MK1_OriginalBodyColors = {}
    local bodyColors = character:FindFirstChildOfClass("BodyColors")
    if bodyColors then
        _G.MK1_OriginalBodyColors["Head"] = bodyColors.HeadColor3
        _G.MK1_OriginalBodyColors["Torso"] = bodyColors.TorsoColor3
        _G.MK1_OriginalBodyColors["LeftArm"] = bodyColors.LeftArmColor3
        _G.MK1_OriginalBodyColors["RightArm"] = bodyColors.RightArmColor3
        _G.MK1_OriginalBodyColors["LeftLeg"] = bodyColors.LeftLegColor3
        _G.MK1_OriginalBodyColors["RightLeg"] = bodyColors.RightLegColor3

        bodyColors.HeadColor3 = DarkGreenStone
        bodyColors.TorsoColor3 = DarkGreenStone
        bodyColors.LeftArmColor3 = DarkGreenStone
        bodyColors.RightArmColor3 = DarkGreenStone
        bodyColors.LeftLegColor3 = DarkGreenStone
        bodyColors.RightLegColor3 = DarkGreenStone
    end

    -- Ocultar Acessórios
    _G.MK1_HiddenAccessories = {}
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Accessory") then
            table.insert(_G.MK1_HiddenAccessories, child)
            child.Parent = nil
        end
    end

    -- Texturas das Roupas
    local shirt = character:FindFirstChildOfClass("Shirt") or Instance.new("Shirt", character)
    local pants = character:FindFirstChildOfClass("Pants") or Instance.new("Pants", character)
    _G.MK1_OriginalShirt = shirt.ShirtTemplate
    _G.MK1_OriginalPants = pants.PantsTemplate
    shirt.ShirtTemplate = SHIRT_ID
    pants.PantsTemplate = PANTS_ID

    -- CAPACETE (Mistura Verde Claro e Escuro)
    if head then
        CreateArmorPart(folder, head, Vector3.new(1.3, 1.2, 1.3), CFrame.new(0, 0.15, 0), LightGreen, Enum.Material.Granite, "HelmetBase")
        CreateArmorPart(folder, head, Vector3.new(0.25, 0.4, 1.3), CFrame.new(0, 0.65, 0), DeepGreenStone, Enum.Material.Granite, "HelmetCrest")
        CreateArmorPart(folder, head, Vector3.new(1.1, 0.5, 0.12), CFrame.new(0, 0.08, -0.65), LightGreen, Enum.Material.Granite, "VisorFrame")
        for i = -2, 2 do
            CreateArmorPart(folder, head, Vector3.new(0.85, 0.06, 0.15), CFrame.new(0, 0.08 + (i * 0.09), -0.67), VisorBlack, Enum.Material.SmoothPlastic, "VisorSlot"..i)
        end
    end

    -- PEITORAL VERDE CLARO & CINTURA
    if torso then
        CreateArmorPart(folder, torso, Vector3.new(2.3, 2.0, 1.5), CFrame.new(0, 0.1, 0), LightGreen, Enum.Material.Granite, "ChestPlate")
        CreateArmorPart(folder, torso, Vector3.new(2.4, 0.7, 1.6), CFrame.new(0, 0.5, 0), DeepGreenStone, Enum.Material.Granite, "UpperChestRim")
        CreateArmorPart(folder, torso, Vector3.new(2.1, 0.5, 1.4), CFrame.new(0, -0.7, 0), LightGreen, Enum.Material.Granite, "BeltPlate")

        CreateArmorPart(folder, torso, Vector3.new(1.8, 1.0, 0.12), CFrame.new(0, -1.1, -0.75), ChainmailColor, Enum.Material.Fabric, "MailFront")
        CreateArmorPart(folder, torso, Vector3.new(1.8, 1.0, 0.12), CFrame.new(0, -1.1, 0.75), ChainmailColor, Enum.Material.Fabric, "MailBack")
        CreateArmorPart(folder, torso, Vector3.new(0.12, 1.0, 1.3), CFrame.new(-1.0, -1.1, 0), ChainmailColor, Enum.Material.Fabric, "MailLeft")
        CreateArmorPart(folder, torso, Vector3.new(0.12, 1.0, 1.3), CFrame.new(1.0, -1.1, 0), ChainmailColor, Enum.Material.Fabric, "MailRight")
    end

    -- BRAÇO DIREITO
    if rightArm then
        CreateArmorPart(folder, rightArm, Vector3.new(1.4, 1.1, 1.4), CFrame.new(0, 0.55, 0), LightGreen, Enum.Material.Granite, "R_ShoulderPad")
        BuildGatlingGun(rightArm, false)
    end

    -- BRAÇO ESQUERDO + ESCUDO TORRE
    if leftArm then
        CreateArmorPart(folder, leftArm, Vector3.new(1.4, 1.1, 1.4), CFrame.new(0, 0.55, 0), LightGreen, Enum.Material.Granite, "L_ShoulderPad")
        
        local shieldOffset = CFrame.new(-0.8, -0.1, -0.1) * CFrame.Angles(0, math.rad(15), 0)
        CreateArmorPart(folder, leftArm, Vector3.new(0.35, 3.6, 2.0), shieldOffset, LightGreen, Enum.Material.Granite, "ShieldPlate")
        CreateArmorPart(folder, leftArm, Vector3.new(0.4, 3.7, 0.25), shieldOffset * CFrame.new(-0.03, 0, 0), DeepGreenStone, Enum.Material.Granite, "ShieldBorder")
        
        CreateArmorPart(folder, leftArm, Vector3.new(0.45, 2.2, 0.25), shieldOffset * CFrame.new(-0.06, 0.1, 0), GoldCrossColor, Enum.Material.Metal, "CrossVertical")
        CreateArmorPart(folder, leftArm, Vector3.new(0.45, 0.3, 1.1), shieldOffset * CFrame.new(-0.06, 0.4, 0), GoldCrossColor, Enum.Material.Metal, "CrossHorizontal")
    end

    -- PERNAS & BOTAS
    if leftLeg then
        CreateArmorPart(folder, leftLeg, Vector3.new(1.3, 1.6, 1.3), CFrame.new(0, -0.1, 0), DarkGreenStone, Enum.Material.Granite, "L_LegArmor")
        CreateArmorPart(folder, leftLeg, Vector3.new(1.4, 0.7, 1.5), CFrame.new(0, -0.6, -0.1), LightGreen, Enum.Material.Granite, "L_Boot")
    end
    if rightLeg then
        CreateArmorPart(folder, rightLeg, Vector3.new(1.3, 1.6, 1.3), CFrame.new(0, -0.1, 0), DarkGreenStone, Enum.Material.Granite, "R_LegArmor")
        CreateArmorPart(folder, rightLeg, Vector3.new(1.4, 0.7, 1.5), CFrame.new(0, -0.6, -0.1), LightGreen, Enum.Material.Granite, "R_Boot")
    end

    -- HABILIDADE: GRAVIDADE ZERO / QUEDA LENTA AO MANTER O PULO
    if _G.MK1_JumpConnection then _G.MK1_JumpConnection:Disconnect() end
    
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local bodyVelocity = nil

    _G.MK1_JumpConnection = UserInputService.JumpRequest:Connect(function()
        if not _G.MK1_Equipped or not character or not hrp then return end

        if humanoid:GetState() == Enum.HumanoidStateType.Freefall or humanoid:GetState() == Enum.HumanoidStateType.Jumping then
            if not bodyVelocity or not bodyVelocity.Parent then
                bodyVelocity = Instance.new("BodyVelocity")
                bodyVelocity.Name = "MK1_ZeroGravity"
                bodyVelocity.MaxForce = Vector3.new(0, 100000, 0)
                bodyVelocity.Velocity = Vector3.new(0, -2, 0) -- Queda lenta / Gravidade Zero
                bodyVelocity.Parent = hrp

                task.delay(1.5, function()
                    if bodyVelocity then
                        bodyVelocity:Destroy()
                        bodyVelocity = nil
                    end
                end)
            end
        end
    end)

    return folder
end

