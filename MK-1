local function BuildGatlingGun(rightArm, isAttackMode)
    if _G.MK1_GatlingFolder then
        _G.MK1_GatlingFolder:Destroy()
        _G.MK1_GatlingFolder = nil
    end

    local folder = Instance.new("Folder")
    folder.Name = "MK1_Gatling_Model"
    folder.Parent = rightArm.Parent

    local gunRotation
    local gunPosOffset

    if isAttackMode then
        gunRotation = CFrame.Angles(0, 0, 0)
        gunPosOffset = CFrame.new(0, -0.7, -1.3) * gunRotation
    else
        gunRotation = CFrame.Angles(math.rad(-90), 0, 0)
        gunPosOffset = CFrame.new(0.8, -0.6, -0.2) * gunRotation
    end

    CreateArmorPart(folder, rightArm, Vector3.new(0.9, 1.1, 1.8), gunPosOffset, DarkMetalColor, Enum.Material.Metal, "GatlingBody")

    for i = 1, 6 do
        local rad = math.rad(i * 60)
        local x = math.cos(rad) * 0.28
        local y = math.sin(rad) * 0.28
        local barrelOffset = gunPosOffset * CFrame.new(x, y, -1.8)
        CreateArmorPart(folder, rightArm, Vector3.new(0.18, 0.18, 2.4), barrelOffset, BrightGreen, Enum.Material.SmoothPlastic, "Barrel"..i)
    end

    _G.MK1_GatlingFolder = folder
end

