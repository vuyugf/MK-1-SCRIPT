local function ToggleMK1()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end

    if _G.MK1_Equipped then
        if _G.MK1_ArmorFolder then _G.MK1_ArmorFolder:Destroy() _G.MK1_ArmorFolder = nil end
        if _G.MK1_GatlingFolder then _G.MK1_GatlingFolder:Destroy() _G.MK1_GatlingFolder = nil end
        if _G.MK1_JumpConnection then _G.MK1_JumpConnection:Disconnect() _G.MK1_JumpConnection = nil end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = 16
            humanoid.JumpPower = 50
            pcall(function() humanoid.SwimmingSpeed = 16 end)
            for _, scaleName in ipairs({"BodyHeightScale", "BodyWidthScale", "BodyDepthScale", "HeadScale"}) do
                local s = humanoid:FindFirstChild(scaleName)
                if s then s.Value = 1.0 end
            end
        end

        local shirt = character:FindFirstChildOfClass("Shirt")
        local pants = character:FindFirstChildOfClass("Pants")
        if shirt and _G.MK1_OriginalShirt then shirt.ShirtTemplate = _G.MK1_OriginalShirt end
        if pants and _G.MK1_OriginalPants then pants.PantsTemplate = _G.MK1_OriginalPants end

        local bodyColors = character:FindFirstChildOfClass("BodyColors")
        if bodyColors and _G.MK1_OriginalBodyColors then
            if _G.MK1_OriginalBodyColors["Head"] then bodyColors.HeadColor3 = _G.MK1_OriginalBodyColors["Head"] end
            if _G.MK1_OriginalBodyColors["Torso"] then bodyColors.TorsoColor3 = _G.MK1_OriginalBodyColors["Torso"] end
            if _G.MK1_OriginalBodyColors["LeftArm"] then bodyColors.LeftArmColor3 = _G.MK1_OriginalBodyColors["LeftArm"] end
            if _G.MK1_OriginalBodyColors["RightArm"] then bodyColors.RightArmColor3 = _G.MK1_OriginalBodyColors["RightArm"] end
            if _G.MK1_OriginalBodyColors["LeftLeg"] then bodyColors.LeftLegColor3 = _G.MK1_OriginalBodyColors["LeftLeg"] end
            if _G.MK1_OriginalBodyColors["RightLeg"] then bodyColors.RightLegColor3 = _G.MK1_OriginalBodyColors["RightLeg"] end
        end

        if _G.MK1_HiddenAccessories then
            for _, acc in ipairs(_G.MK1_HiddenAccessories) do
                if acc then acc.Parent = character end
            end
            _G.MK1_HiddenAccessories = {}
        end

        _G.MK1_Equipped = false
        _G.MK1_AttackMode = false
    else
        _G.MK1_ArmorFolder = BuildMK1Armor(character)
        _G.MK1_Equipped = true
    end
end

